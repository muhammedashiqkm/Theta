THETA_ENVIRONMENT=development

# Must be identical to Theta:ApiToken in the OnlineCampus API's appsettings.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
THETA_SERVICE_TOKEN=

# Used by docker-compose for the database container AND in the URL below.
THETA_DB_PASSWORD=theta_dev_password
THETA_DATABASE_URL=postgresql+asyncpg://theta:theta_dev_password@127.0.0.1:5433/theta
THETA_REDIS_URL=redis://127.0.0.1:6380/0

# Question writing and AI marking with Claude (POST /v1/generate/questions and
# /v1/mark/*). Leave the key empty to switch both off; the endpoints then answer 503.
THETA_ANTHROPIC_API_KEY=
THETA_GENERATION_MODEL=claude-opus-5
THETA_MARKING_MODEL=claude-opus-5
